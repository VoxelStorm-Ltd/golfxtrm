<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="GolfXTRM client" />
		<Option pch_mode="2" />
		<Option default_target="Win32_Release" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Win32_Debug">
				<Option output="bin/Win32_Debug/GolfXTRM debug" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win32_Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=gnu++1y" />
					<Add option="-Og" />
					<Add option="-DWINVER=0x0501" />
					<Add option="-D_WIN32_WINNT=0x0501" />
					<Add option="-DSKIPINTRO" />
					<Add option="-DNOMUSIC" />
				</Compiler>
				<Linker>
					<Add library="lib\libboost_chrono-mgw48-mt-sd-1_53.a" />
					<Add library="lib\libboost_thread-mgw48-mt-sd-1_53.a" />
					<Add library="lib\libboost_system-mgw48-mt-sd-1_53.a" />
				</Linker>
			</Target>
			<Target title="Win32_Release">
				<Option output="bin/Win32_Release/GolfXTRM/GolfXTRM" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win32_Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectCompilerOptionsRelation="1" />
				<Compiler>
					<Add option="-fomit-frame-pointer" />
					<Add option="-fexpensive-optimizations" />
					<Add option="-std=gnu++1y" />
					<Add option="-Ofast" />
					<Add option="-fgcse-sm" />
					<Add option="-fgcse-las" />
					<Add option="-fgcse-after-reload" />
					<Add option="-fsched-spec-load" />
					<Add option="-fsched-spec-load-dangerous" />
					<Add option="-fprofile-generate" />
					<Add option="-fbranch-probabilities" />
					<Add option="-fprofile-arcs" />
					<Add option="-fprofile-use" />
					<Add option="-fprofile-values" />
					<Add option="-fsched2-use-traces" />
					<Add option="-fpeel-loops" />
					<Add option="-funroll-loops" />
					<Add option="-funswitch-loops" />
					<Add option="-DWINVER=0x0501" />
					<Add option="-D_WIN32_WINNT=0x0501" />
					<Add option="-DINTRO" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-fprofile-arcs" />
					<Add option="-lgcov" />
					<Add library="lib\libboost_chrono-mgw48-mt-s-1_53.a" />
					<Add library="lib\libboost_thread-mgw48-mt-s-1_53.a" />
					<Add library="lib\libboost_system-mgw48-mt-s-1_53.a" />
				</Linker>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="Win32_Debug;Win32_Release;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-DGLEW_STATIC" />
			<Add directory="include" />
			<Add directory="$(#glfw.include)" />
			<Add directory="$(#boost.include)" />
			<Add directory="$(#glew.include)" />
			<Add directory="lib" />
		</Compiler>
		<Linker>
